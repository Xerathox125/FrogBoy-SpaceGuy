:root {
}

.text {
    font-size: 150px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
    white-space: normal;
    letter-spacing: 12px;
    margin-left: 1px;
}

.button {
    width: 400px;
    height: 400px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-left-radius: 30px;
    background-color: rgb(122, 41, 150);
    font-size: 150px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.ventanaNivelesDefault {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
}

.ventanaNivelesRight {
    translate: 2032px 0;
}

.button:hover {
    scale: 1.1 1.1;
}
